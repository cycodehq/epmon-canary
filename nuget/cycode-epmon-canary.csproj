<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cycode-epmon-canary</AssemblyName>
    <RootNamespace>CycodeEpmonCanary</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cycode-epmon-canary</ToolCommandName>
    <PackageId>cycode-epmon-canary</PackageId>
    <Version>1.0.0</Version>
    <Authors>Cycode</Authors>
    <Description>Harmless package flagged by Cycode EPMON on purpose, so you can verify the install is protected</Description>
    <PackageTags>cycode;epmon;canary;supply-chain</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/cycodehq/epmon-canary#readme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cycodehq/epmon-canary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
